# CyberAuth - Environment Configuration
# Copy to .env and adjust as needed
# NO COMMIT REAL SECRETS

# ==========================================
# DATABASE
# ==========================================
# PostgreSQL (production)
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/cyberauth
# SQLite (development only)
DATABASE_URL=sqlite+aiosqlite:///./auth.db

# ==========================================
# SECURITY - JWT
# ==========================================
# REQUIRED: Minimum 32 characters, high entropy
# Generate with: openssl rand -base64 32
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_MIN_32_CHARS_HIGH_ENTROPY
ALGORITHM=HS256

# Sliding expiration window (minutes of inactivity)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Absolute session lifetime cap (hours)
MAX_SESSION_LIFETIME_HOURS=8

# JWT Claims
JWT_ISSUER=CyberAuth
JWT_AUDIENCE=cyberauth-api

# ==========================================
# ACCOUNT LOCKOUT (separate from IP rate limit)
# ==========================================
MAX_FAILED_ATTEMPTS=5
ACCOUNT_LOCK_WINDOW_MINUTES=15

# ==========================================
# IP RATE LIMITING (Redis required in production)
# ==========================================
IP_RATE_LIMIT_MAX=100
IP_RATE_LIMIT_WINDOW_MINUTES=15

# ==========================================
# REDIS (mandatory in production for sessions, denylist, rate limit)
# ==========================================
REDIS_URL=redis://localhost:6379/0

# ==========================================
# CORS & HTTPS
# ==========================================
# Comma-separated list of allowed origins (no wildcard in production)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Trusted proxy IPs for HTTPS enforcement (X-Forwarded-Proto, Forwarded header)
# Empty = disable HTTPS enforcement middleware
# Example: TRUSTED_PROXY_IPS=10.0.0.1,10.0.0.2
TRUSTED_PROXY_IPS=

# ==========================================
# PRIVACY POLICY (Ley 1581/2012)
# ==========================================
POLICY_VERSION=1.0

# ==========================================
# APP
# ==========================================
APP_NAME=CyberAuth
DEBUG=false
LOG_LEVEL=INFO